DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173

# PostgreSQL e o banco oficial do projeto. Para testes isolados, use DB_ENGINE=sqlite.
DB_ENGINE=postgresql
DB_NAME=pandora_db
DB_USER=pandora_app
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# Simulação de frete. Informe o CEP real do depósito antes de usar comercialmente.
# Sem FREIGHT_ORIGIN_CEP, a simulação parte provisoriamente do Centro de Leme/SP.
FREIGHT_ORIGIN_CEP=
FREIGHT_ORIGIN_LABEL=
FREIGHT_MINIMUM_PER_LEG=25.00
FREIGHT_RATE_PER_KM=3.00
FREIGHT_ROAD_FACTOR=1.30
