# Configuração local para desenvolvimento e testes.
# Copie para api/.env. Nunca coloque credenciais pessoais neste exemplo.
# Antes de iniciar, preencha DJANGO_SECRET_KEY e DB_PASSWORD no seu .env.

# 1. Django e endereços locais
# Gere sua chave com: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Cole o resultado somente em DJANGO_SECRET_KEY no arquivo .env.
DJANGO_SECRET_KEY=preencha_com_uma_chave_aleatoria_exclusiva
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# 2. PostgreSQL local: crie pandora_db no pgAdmin, conforme o README.
# Use o usuário e a senha que você definiu na instalação do PostgreSQL.
DB_ENGINE=postgresql
DB_NAME=pandora_db
DB_USER=postgres
DB_PASSWORD=preencha_com_a_senha_do_seu_postgresql
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# 3. E-mail de marketing: modo de teste, sem envio de mensagens reais.
# O conteúdo aparece no terminal da API. Não é necessário um servidor SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=teste@example.invalid
# Para envio real, use django.core.mail.backends.smtp.EmailBackend e configure
# os dados SMTP do seu serviço exclusivamente no .env local.

# 4. Frete e mapa: origem do depósito já configurada para o projeto.
# As consultas de endereço e rota precisam de internet.
FREIGHT_ORIGIN_CEP=13614032
FREIGHT_ORIGIN_ADDRESS=Av. Joaquim Lopes Aguila, 3000 - Barra Funda, Leme - SP, 13614-032
FREIGHT_ORIGIN_LABEL=Av. Joaquim Lopes Aguila, 3000 - Barra Funda, Leme - SP, 13614-032
FREIGHT_ORIGIN_LATITUDE=-22.1757125
FREIGHT_ORIGIN_LONGITUDE=-47.3820152
FREIGHT_MINIMUM_PER_LEG=25.00
FREIGHT_RATE_PER_KM=3.00
FREIGHT_ITEMS_PER_TRIP=3
FREIGHT_OPERATIONAL_COST_PER_TRIP=0.00
FREIGHT_EXTRA_FEE=0.00
FREIGHT_CITY_SURCHARGES={}
GEOCODING_ENABLED=true
# Serviços públicos para desenvolvimento. Em produção, configure seus provedores.
FREIGHT_ROUTING_URL=https://router.project-osrm.org
GEOCODING_SEARCH_URL=https://nominatim.openstreetmap.org/search

# 5. Assistente de IA: opcional. O restante do sistema funciona sem uma chave.
# Para habilitar, crie sua chave em https://console.groq.com/keys,
# preencha GROQ_API_KEY no .env local, altere AI_ENABLED=true e reinicie a API.
# A disponibilidade dos modelos depende da sua conta no provedor.
GROQ_API_KEY=
AI_ENABLED=false
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT=40/min
